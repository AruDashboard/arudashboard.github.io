---
import Layout from '../layouts/Layout.astro';
import TableSheet from '../components/TableSheet.astro';

// 预留页面：在下面填写 caption / columns / rows 即可。
// columns 为表头，rows 为数据（每行一个数组）。
// 留空时会铺 emptyRows 个空行，占满整页方便手动填写。
const caption = '预留页面 2';
const columns: string[] = [];
const rows: string[][] = [];
---

<Layout title="预留页面 2" description="待填充内容" fill showHome>
  <TableSheet caption={caption} columns={columns} rows={rows} emptyRows={24} />
</Layout>
